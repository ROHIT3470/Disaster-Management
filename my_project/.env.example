# Copy these values into the environment used to run the Python tools.
# Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MONGO_URI=mongodb://127.0.0.1:27017/disaster_management
MONGO_DB_NAME=disaster_management

# Required only by the NASA GPM downloader.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
